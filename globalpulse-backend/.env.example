APP_NAME=GlobalPulse
APP_ENV=development
APP_VERSION=0.1.0

# ── Market Data (Finnhub) ──────────────────────────────────────────────────
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_TIMEOUT_SECONDS=10

# ── Economic & Macro Data (Trading Economics) ─────────────────────────────
# Get your key at: https://tradingeconomics.com/settings/api.aspx
# Note: Endpoint availability depends on your subscription plan.
#       Free/basic plans have restricted access. Provider will return a clear
#       error (PROVIDER_FEATURE_UNAVAILABLE) for unsupported endpoints.
TRADING_ECONOMICS_API_KEY=
TRADING_ECONOMICS_BASE_URL=https://api.tradingeconomics.com
TRADING_ECONOMICS_TIMEOUT_SECONDS=10

# ── News & Global Events (NewsAPI) ────────────────────────────────────────
# Get your key at: https://newsapi.org/register
# Note: Free plan limited to 100 req/day, 1-month history, headlines only.
NEWS_API_KEY=
NEWS_API_BASE_URL=https://newsapi.org/v2
NEWS_API_TIMEOUT_SECONDS=10

# ── Database (reserved for future phases) ─────────────────────────────────
DATABASE_URL=

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
